    {
      "parameters": {
        "jsCode": "// Normaliza las 3 fuentes TSV a arrays de objetos\nconst items = [];\nfor (const file of $input.all()) {\n  const raw = file.json.data || '';\n  const lines = String(raw).split(/\\r?\\n/).filter(Boolean);\n  if (!lines.length) continue;\n  const headers = lines[0].split('\\t').map(h => h.trim().toLowerCase().replace(/[^a-z0-9_]/g, ''));\n  for (const line of lines.slice(1)) {\n    const cells = line.split('\\t');\n    const row = {};\n    headers.forEach((h, i) => { row[h] = cells[i] ?? null; });\n    items.push({ json: { tabla: file.json.name || 'desconocida', ...row } });\n  }\n}\nreturn items;"
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
